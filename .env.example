# Leave CONTACT_PROVIDER unset to auto-select:
# 1) webhook when CONTACT_FORM_WEBHOOK_URL is defined
# 2) resend when RESEND_API_KEY is defined
# 3) console otherwise
# CONTACT_PROVIDER=resend

# Resend delivery
RESEND_API_KEY=
CONTACT_FORM_FROM=website@unyragroup.com
CONTACT_FORM_TO=sales@unyragroup.com

# Webhook delivery
CONTACT_FORM_WEBHOOK_URL=

# Optional subject prefix
CONTACT_SUBJECT_PREFIX="[Unyra Inquiry]"
